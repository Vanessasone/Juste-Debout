{
  "buildCommand": "npx expo export --platform web && node scripts/add-share-metadata.cjs",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/((?!_vercel/|_expo/|assets/|media/|email/|favicon\\.ico|manifest\\.webmanifest|app-icon\\.png).*)",
      "destination": "/index.html"
    }
  ]
}
