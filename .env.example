# Identifiants Supabase — copie ce fichier en « .env » et remplis les valeurs.
# Où les trouver : Supabase → ton projet → Settings → API
#   - Project URL           → EXPO_PUBLIC_SUPABASE_URL
#   - Project API keys : anon public  → EXPO_PUBLIC_SUPABASE_ANON_KEY
# ⚠️ N'utilise JAMAIS la clé « service_role » ici (elle est secrète).

EXPO_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.xxxxxxxx
